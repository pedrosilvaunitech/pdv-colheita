# =============================================================================
# BastionPOS / PDV Colheita — exemplo de variáveis de ambiente
# =============================================================================
# Copie para `.env.local` (ignorado pelo Git) ao rodar fora do Lovable.
# NUNCA coloque aqui valores reais de credenciais privadas.
#
# Regra de ouro:
#   - Chaves `sb_publishable_...` e URLs são PÚBLICAS (vão no bundle do browser).
#   - Chave service role, senha do banco, certificado A1 (.pfx), senha do
#     certificado e CSC Token da SEFAZ são SEGREDOS. Eles NUNCA entram em
#     arquivo de ambiente versionado: ficam no cofre de secrets do backend
#     (Lovable Cloud) ou em tabelas protegidas por RLS.
# -----------------------------------------------------------------------------

# --- Backend (Lovable Cloud / Supabase) — valores publicáveis ----------------
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

# Mesmas variáveis expostas ao frontend pelo Vite (prefixo VITE_ obrigatório).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

# --- Agente Local (opcional, apenas no PC do caixa) --------------------------
# Endereço do Bastion POS Agent para impressão ESC/POS, gaveta, balança,
# PIN Pad TEF e emissão NFC-e embarcada.
VITE_AGENT_URL="http://127.0.0.1:9110"

# --- Testes E2E (opcional, só no CI) -----------------------------------------
# Sem estas variáveis os cenários autenticados do Playwright são pulados.
E2E_BASE_URL="http://localhost:8080"
E2E_EMAIL=""
E2E_PASSWORD=""

# =============================================================================
# NÃO COLOQUE NESTE ARQUIVO (nem em nenhum outro versionado):
#   SUPABASE_SERVICE_ROLE_KEY   -> indisponível no Lovable Cloud, por design
#   FISCAL_CERT_PFX_BASE64      -> certificado A1 fica na tabela fiscal_configs
#   FISCAL_CERT_PASSWORD        -> idem
#   NFCE_CSC_TOKEN              -> credencial de assinatura do QR Code NFC-e
#   TEF_*_MERCHANT_KEY          -> credenciais das adquirentes (SiTef, PayGo...)
# =============================================================================
